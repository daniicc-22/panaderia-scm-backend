  panaderia_id           String?                  @db.Uuid
  nombre                 String
  contacto               String?
  telefono               String?
  direccion              String?
  activo                 Boolean                  @default(true)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  compra                 compra[]
  presentacion_proveedor presentacion_proveedor[]
  grupo                  grupo?                   @relation(fields: [grupo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  panaderia              panaderia?               @relation(fields: [panaderia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, panaderia_id])
  @@index([grupo_id], map: "idx_proveedor_grupo")
  @@index([panaderia_id], map: "idx_proveedor_panaderia")
}

