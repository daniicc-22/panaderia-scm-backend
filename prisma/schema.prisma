model analisis_eoq {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panaderia_id          String          @db.Uuid
  materia_prima_id      String          @db.Uuid
  fecha_corte           DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  demanda_anual_d       Decimal         @db.Decimal(14, 3)
  costo_pedido_s        Decimal?        @db.Decimal(12, 2)
  costo_mantenimiento_h Decimal?        @db.Decimal(12, 4)
  eoq_calculado         Decimal?        @db.Decimal(12, 3)
  lead_time_dias        Decimal?        @db.Decimal(6, 2)
  stock_seguridad       Decimal?        @db.Decimal(12, 3)
  punto_reorden         Decimal?        @db.Decimal(12, 3)
  estado                estado_eoq_enum
  advertencias          String?
  created_at            DateTime        @default(now()) @db.Timestamptz(6)
  materia_prima         materia_prima   @relation(fields: [materia_prima_id, panaderia_id], references: [id, panaderia_id], onDelete: NoAction, onUpdate: NoAction)
  panaderia             panaderia       @relation(fields: [panaderia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([panaderia_id, fecha_corte], map: "idx_analisis_eoq_corte")
}

